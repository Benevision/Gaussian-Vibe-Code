#version 460
#extension GL_GOOGLE_include_directive : require
// Loss, step 4 (Mac: loss_grad): dL/dimage for L = (1−λ)·mean|x−y| + λ·(1 − mean SSIM), the mean taken over
// all pixels and the three channels. bd holds the blurred SSIM derivative maps (blur adjoint = blur).
// gradImg planes: 0–2 rgb, 3 depth (Σ α·T·z), 4 an extra dL/dT_final per pixel (raster_bwd adds it to the
// background term). Planes 3 and 4 are zeroed here; depth_gather and sky_backward fill them.
// pc.split = 1 (decoupled SSIM): planes 0–2 get the corrected render's gradient (L1 and the luminance term), and
// gradRaw the direct gradient w.r.t. the raw render (the contrast-structure term), added in corr_backward.
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer FrameBuf { Frame F; };
layout(std430, binding = 1) readonly buffer PlaneBuf { float planes[]; };
layout(std430, binding = 2) readonly buffer BdBuf { float bd[]; };
layout(std430, binding = 3) writeonly buffer GradBuf { float gradImg[]; };
layout(std430, binding = 4) writeonly buffer GradRawBuf { float gradRaw[]; };
layout(push_constant) uniform PC { uint split; } pc;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= F.width || p.y >= F.height) return;
    uint hw = F.width * F.height, pid = p.y * F.width + p.x;
    float norm = F.invNumPixels / 3.0;
    float snorm = F.invSsimPixels / 3.0;
    float lam = F.ssimWeight;
    for (uint c = 0u; c < 3u; c++) {
        if (pc.split == 0u) {
            float x = planes[(c * 5u) * hw + pid], y = planes[(c * 5u + 1u) * hw + pid];
            float dS = bd[(c * 3u + 0u) * hw + pid] + 2.0 * x * bd[(c * 3u + 1u) * hw + pid] + y * bd[(c * 3u + 2u) * hw + pid];
            float l1g = x > y ? 1.0 : (x < y ? -1.0 : 0.0);
            gradImg[c * hw + pid] = norm * (1.0 - lam) * l1g - snorm * lam * dS;
        } else {
            float x = planes[(c * 6u) * hw + pid], y = planes[(c * 6u + 1u) * hw + pid], r = planes[(c * 6u + 5u) * hw + pid];
            float l1g = x > y ? 1.0 : (x < y ? -1.0 : 0.0);
            gradImg[c * hw + pid] = norm * (1.0 - lam) * l1g - snorm * lam * bd[(c * 4u + 0u) * hw + pid];
            float dR = bd[(c * 4u + 1u) * hw + pid] + 2.0 * r * bd[(c * 4u + 2u) * hw + pid] + y * bd[(c * 4u + 3u) * hw + pid];
            gradRaw[c * hw + pid] = -snorm * lam * dR;
        }
    }
    gradImg[3u * hw + pid] = 0.0;
    gradImg[4u * hw + pid] = 0.0;
}
