#version 460
#extension GL_GOOGLE_include_directive : require
// Per-photo colour correction, forward (Mac: appearance_apply / bilagrid_apply). Keeps the uncorrected render in
// raw and writes the corrected one into img (the loss compares that with the photo):
//   mode 1, trainer.py AppearanceCorrection: img = M · raw + b, params = M (3×3 row-major), b (3);
//   mode 2, trainer.py BilateralGrid: img = A · raw + b with [A | b] the trilinear blend of the photo's grid at
//           (x, y, luminance of raw) (common.glsl bg_coords; the luminance guide carries no gradient).
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer FrameBuf { Frame F; };
layout(std430, binding = 1) buffer ImgBuf { float img[]; };
layout(std430, binding = 2) writeonly buffer RawBuf { float raw[]; };
layout(std430, binding = 3) readonly buffer ParBuf { float par[]; };
layout(push_constant) uniform PC { uint mode; } pc;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= F.width || p.y >= F.height) return;
    uint hw = F.width * F.height, pid = p.y * F.width + p.x;
    vec3 x = vec3(img[pid], img[hw + pid], img[2u * hw + pid]);
    raw[pid] = x.x; raw[hw + pid] = x.y; raw[2u * hw + pid] = x.z;
    float c[12];
    if (pc.mode == 1u) {
        for (int r = 0; r < 3; r++) {
            c[r * 4] = par[r * 3]; c[r * 4 + 1] = par[r * 3 + 1]; c[r * 4 + 2] = par[r * 3 + 2]; c[r * 4 + 3] = par[9 + r];
        }
    } else {
        ivec3 i0; vec3 f;
        bg_coords(p, F.width, F.height, dot(x, vec3(LUMA_R, LUMA_G, LUMA_B)), i0, f);
        for (int k = 0; k < 12; k++) {
            float v = 0.0;
            for (int dz = 0; dz < 2; dz++) for (int dy = 0; dy < 2; dy++) for (int dx = 0; dx < 2; dx++) {
                float w = (dx != 0 ? f.x : 1.0 - f.x) * (dy != 0 ? f.y : 1.0 - f.y) * (dz != 0 ? f.z : 1.0 - f.z);
                v += w * par[bg_index(k, i0.z + dz, i0.y + dy, i0.x + dx)];
            }
            c[k] = v;
        }
    }
    for (int r = 0; r < 3; r++) img[uint(r) * hw + pid] = c[r * 4] * x.x + c[r * 4 + 1] * x.y + c[r * 4 + 2] * x.z + c[r * 4 + 3];
}
