#version 460
#ifdef NATIVE_FLOAT_ATOMICS
#extension GL_EXT_shader_atomic_float : require
#endif
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Float atomic add probe: acc[0] += subgroup sums of 1 (one atomic per subgroup, as in raster_bwd);
// acc[1 + i % 7] += 1 from every invocation (contended per-lane atomics). Exact in float for small n.
layout(local_size_x = 256) in;
#ifdef NATIVE_FLOAT_ATOMICS
layout(std430, binding = 0) buffer AccBuf { float acc[]; };
void accAdd(uint i, float v) { atomicAdd(acc[i], v); }
#else
layout(std430, binding = 0) buffer AccBuf { uint acc[]; };
void accAdd(uint i, float v) {
    uint old = acc[i];
    for (;;) {
        uint nv = floatBitsToUint(uintBitsToFloat(old) + v);
        uint prev = atomicCompSwap(acc[i], old, nv);
        if (prev == old) break;
        old = prev;
    }
}
#endif
layout(push_constant) uniform PC { uint n; uint mode; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (pc.mode == 0u) {
        float s = subgroupAdd(i < pc.n ? 1.0 : 0.0);
        if (subgroupElect()) accAdd(0u, s);
    } else if (i < pc.n) {
        accAdd(1u + i % 7u, 1.0);
    }
}
