# gsplat for AMD GPUs (ROCm / HIP), compiled by .github/workflows/gsplat-rocm-wheel.yml (or build-gsplat-rocm-wheel.sh
# on a PC with podman / docker) and attached to the GitHub prerelease gsplat-<version>-<rocm tag>. Used only by the
# experimental "rocm6.4-train" runtime profile (gui/runtime_plan.py). AMD's port of gsplat officially supports
# Instinct MI300X / MI325X; the Radeon targets below are unofficial — that's what the spike tests.
GSPLAT_ROCM_REPO=https://github.com/AMD-Ecosystem/gsplat.git
GSPLAT_ROCM_REF=release/1.5.3b2
GSPLAT_VERSION=1.5.3
TORCH_VERSION=2.8.0
ROCM_TAG=rocm6.4
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-22.04:6.4.3
PYTORCH_ROCM_ARCH=gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201;gfx90a;gfx942
