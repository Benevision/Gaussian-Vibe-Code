# gsplat for AMD GPUs (ROCm / HIP), compiled by .github/workflows/gsplat-rocm-wheel.yml (or build-gsplat-rocm-wheel.sh
# on a PC with podman / docker) and attached to the GitHub prerelease gsplat-<version>-<rocm tag>. Used only by the
# experimental "rocm6.4-train" runtime profile (gui/runtime_plan.py). Radeon targets: unofficial, that's what
# the spike tests.
# Source: "upstream" = nerfstudio gsplat converted by PyTorch's hipify at build time (CUDA's 32-wide warps match
# Radeon's wave32); "amd" = AMD's ROCm port (release/1.5.3b2), which is written for Instinct's 64-wide wavefronts and
# does not compile for Radeon (tried 2026-11-13: wave32 tile errors, and wave64 isn't supported by HIP on RDNA).
GSPLAT_ROCM_FLAVOR=upstream
GSPLAT_ROCM_REPO=https://github.com/nerfstudio-project/gsplat.git
GSPLAT_ROCM_REF=v1.5.3
GSPLAT_VERSION=1.5.3
TORCH_VERSION=2.8.0
ROCM_TAG=rocm6.4
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-22.04:6.4.3
# Radeon only (RDNA 2 / 3 / 4); Instinct cards (gfx90a / gfx942) have AMD's own wheel.
PYTORCH_ROCM_ARCH=gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201
